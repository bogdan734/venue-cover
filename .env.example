DATABASE_URL=postgres://venue:venue@localhost:54329/venue
PORT=3000
# demo (no model: recorded answers of a local model for the examples, a plain keyword reader for other text),
# ollama (local, free) or anthropic
LLM_PROVIDER=demo
# OLLAMA_MODEL=qwen2.5:14b
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# lexical (offline, nothing to download) or transformers (a multilingual model of about 120 MB,
# downloaded once from the Hugging Face hub into .cache/models, then offline)
EMBEDDER=transformers
# MODEL_CACHE=
# The secret the privacy shield derives each program's keys from (tags, sealed originals): 32 random characters or
# more, e.g. `openssl rand -base64 32`. Changing it makes stored originals unreadable.
PRIVACY_SECRET=dev-only-privacy-secret-change-me
# Names in descriptions: model (a multilingual model of about 135 MB, downloaded once into .cache/models) or rules
# (cues only). Unset: the model when it is already on disk.
# NAMES=
# HOST=127.0.0.1

# A Telegram bot from @BotFather lets renters write to a program in Telegram too (long polling: no public address needed).
# TELEGRAM_BOT_TOKEN=
